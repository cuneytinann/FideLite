{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",

  "trailingSlash": false,

  "rewrites": [
    { "source": "/tr", "destination": "/tr/index.html" }
  ],

  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/tr/", "destination": "/tr", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/(.*)", "destination": "/", "permanent": true },
    { "source": "/special/LUX_inProgress.html", "destination": "/builds/LUX/LUX.html", "permanent": true },
    { "source": "/special/L3_packed.html", "destination": "/builds/L3_packed.html", "permanent": true },
    { "source": "/special/L3_numerical_packed.html", "destination": "/builds/L3_numerical_packed.html", "permanent": true },
    { "source": "/builds/special/L3_packed.html", "destination": "/builds/L3_packed.html", "permanent": true },
    { "source": "/builds/special/L3_numerical_packed.html", "destination": "/builds/L3_numerical_packed.html", "permanent": true },
    { "source": "/special/:path*", "destination": "/builds/special/:path*", "permanent": true }
  ],

  "headers": [
    {
      "source": "/(images|icons)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/builds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
